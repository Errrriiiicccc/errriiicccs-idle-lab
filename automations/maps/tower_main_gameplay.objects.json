      "fling_up_badge_ny": 0.615,
      "fling_down_badge_nx": 0.94,
      "fling_down_badge_ny": 0.870,
      "notes": "Scrollbar lane on list viewport (panel ~0.60–0.92). Fling+step pairs clustered: T/R at top, F/G at bottom. drag_fraction 0.10 + hold_end_ms 450 = calibrated one-row drag (was 0.15/60 and overshot). Buy labels come from nameplate OCR, not scroll math."
    },
    "buy_visual_states": {
      "maxxed": {
        "description": "Stat at max — buy inert. Color TBD from observation crops."
      },
      "affordable": {
        "description": "Enough cash — buy fires. Color TBD from observation crops."
      },
      "unaffordable": {
        "description": "Not enough cash — buy inert or no-ops. Color TBD from observation crops."
      }
    }
