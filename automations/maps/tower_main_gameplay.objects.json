{
  "version": 1,
  "id": "tower_main_gameplay",
  "title": "The Tower — main gameplay",
  "surface": "main_gameplay",
  "notes": "Tower-first object map for Live Control Overlay. Templates declare kind + actuations + effects; instances fill geometry from observation/calibration (593×1028). Legacy flat playbook fields are projected from this graph.",
  "hotkeys": {
    "tab_attack": "Q",
    "tab_defense": "W",
    "tab_utility": "E",
    "buy_1": "1",
    "buy_2": "2",
    "buy_3": "3",
    "buy_4": "4",
    "buy_5": "5",
    "buy_6": "6",
    "scroll_up": "R",
    "scroll_down": "F",
    "fling_up": "T",
    "fling_down": "G",
    "stat_collect": "V",
    "refresh": "B",
    "toggle_legend": "D"
  },
  "kind_templates": {
    "button": {
      "description": "Generic clickable control. Optional keyboard activation. Declares world and/or UI effects.",
      "actuations": ["click", "key"]
    },
    "tab_button": {
      "description": "Footer tab that opens or replaces a named panel. Never retap when already active (closes the panel).",
      "actuations": ["click"],
      "rules": ["no_retap_if_active"]
    },
    "panel": {
      "description": "UI region hosting children. Opened by a tab_button; minimized/switched by other tabs.",
      "actuations": []
    },
    "scroll_list": {
      "description": "Continuous list scrolled by click-drag. Contains buy_button slots with a calibrated row geometry.",
      "actuations": ["drag"]
    },
    "buy_button": {
      "description": "Upgrade purchase tile. Spends cash and raises the associated stat. Visual state tracks max / affordable / unaffordable.",
      "actuations": ["click"]
    }
  },
  "shared": {
    "buy_grid": {
      "cols": 2,
      "rows": 3,
      "origin_nx": 0.32,
      "origin_ny": 0.735,
      "col_dx": 0.40,
      "row_dy": 0.088,
      "card_nw": 0.30,
      "card_nh": 0.08
    },
    "upgrade_list_scroll": {
      "nx": 0.45,
      "ny": 0.72,
      "drag_fraction": 0.15,
      "rows_per_key": 1,
      "hold_end_ms": 350,
      "settle_ms": 450,
      "drag_steps": 10,
      "step_ms": 20,
      "fling_fraction": 0.42,
      "fling_steps": 8,
      "fling_step_ms": 8,
      "fling_settle_ms": 700,
      "up_badge_nx": 0.94,
      "up_badge_ny": 0.655,
      "down_badge_nx": 0.94,
      "down_badge_ny": 0.830,
      "fling_up_badge_nx": 0.94,
      "fling_up_badge_ny": 0.615,
      "fling_down_badge_nx": 0.94,
      "fling_down_badge_ny": 0.870,
      "notes": "Scrollbar lane on list viewport (panel ~0.60–0.92). Fling+step pairs clustered: T/R at top, F/G at bottom."
    },
    "buy_visual_states": {
      "maxxed": {
        "description": "Stat at max — buy inert. Color TBD from observation crops."
      },
      "affordable": {
        "description": "Enough cash — buy fires. Color TBD from observation crops."
      },
      "unaffordable": {
        "description": "Not enough cash — buy inert or no-ops. Color TBD from observation crops."
      }
    }
  },
