{
  "id": "minute_clip",
  "title": "Minute clip",
  "version": 1,
  "enabled": true,
  "priority": 100,
  "timing": {"type": "interval", "every_ms": 60000},
  "notes": "Every 60s: OCR wave, record 10s clip, CSV row. Higher priority — blocks ocr_ab_tick while recording.",
  "actions": [
    {"type": "screenshot", "prefix": "preclip"},
    {"type": "ocr", "roi": "wave_roi", "variable": "wave_number", "parse_as": "wave"},
    {"type": "log", "message": "preclip wave={wave_number}", "level": "info"},
    {"type": "record_clip", "duration_s": 10},
    {"type": "csv_append", "path": "run_log.csv"}
  ]
}
