{
  "id": "ocr_ab_tick",
  "title": "OCR A/B tick",
  "version": 1,
  "enabled": true,
  "priority": 10,
  "timing": {"type": "interval", "every_ms": 10000},
  "notes": "Every 10s: screenshot → OCR signal → branch A or B. Lower priority than minute_clip.",
  "actions": [
    {"type": "screenshot", "prefix": "ab"},
    {"type": "ocr", "roi": "signal_roi", "variable": "signal", "parse_as": "signal"},
    {
      "type": "decide",
      "variable": "signal",
      "match_a": "A",
      "mode": "equals",
      "on_a": [
        {"type": "log", "message": "branch A — playing ab choice a", "level": "ok"},
        {"type": "play_preset", "preset": "ab choice a"}
      ],
      "on_b": [
        {"type": "log", "message": "branch B — playing ab choice b", "level": "ok"},
        {"type": "play_preset", "preset": "ab choice b"}
      ]
    }
  ]
}
